<Project>
  <PropertyGroup>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <MandroidI18n>CJK;Mideast;Rare;West;Other;</MandroidI18n>
    <!-- NullabilityInfoContextSupport is disabled by default for Android -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Can be removed in .NET 11 (CoreCLR is the default) -->
    <UseMonoRuntime>false</UseMonoRuntime>
    <!-- Do not trim. Release is the only configuration that enables PublishTrimmed by default, and the
         desktop builds opt out explicitly (see "-p:PublishTrimmed=false" in .github/actions/*-build.sh);
         Android was simply left relying on the default. With CoreCLR that default produces an APK which
         dies on startup: the same build with -p:PublishTrimmed=false runs, the trimmed one crashes
         immediately (verified on an arm64 device). The trimmer removes framework members that osu.Game
         only reaches through reflection.
         Costs roughly 32MB of APK size; revisit once trimming on Android+CoreCLR is trustworthy. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- CoreCLR on Android is an experimental feature in .NET 10.
         This suppression can be removed after .NET 11, as the use of CoreCLR becomes the default in .NET 11 and above. -->
    <NoWarn>$(NoWarn);XA1040</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="g0v0.Framework.Android" Version="2026.1111.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- ppy.osu.Framework.NativeLibs and ppy.SDL2-CS only carry desktop (linux/win/osx) native
         libraries; the Android ones are shipped as an aar by g0v0.Framework.Android, which is
         referenced above.

         ppy.osu.Framework.NativeLibs contains an empty "runtimes/android/native/_._" placeholder so
         that NuGet resolves no native assets at all for android-* RIDs, but that placeholder is not
         always honoured. With the ~/.nuget/packages cache state that GitHub Actions restores from
         its own cache, NuGet instead falls back to the compatible linux-<arch> RID and copies glibc
         builds of libbass / libbassmix / libbass_fx into lib/<abi>/ of the APK. Those take
         precedence over the bionic libraries extracted from the aar - the only sign of it being a
         warning ("APK already contains the item lib/arm64-v8a/libbass.so; ignoring") - and the
         packaged game then dies on startup on arm64 devices with:

           System.DllNotFoundException: bass
           at ManagedBass.Bass.get_DeviceCount()

         Exclude the desktop native assets from Android builds so that only Android (bionic)
         libraries can be packaged. -->
    <PackageReference Include="ppy.osu.Framework.NativeLibs" Version="2026.1029.0" ExcludeAssets="native" />

    <!-- ppy.SDL2-CS additionally declares its app.config as a contentFile with buildAction="Content"
         in its nuspec. NuGet surfaces that as a Content item, and the Android SDK refuses those:

           warning XA0101: @(Content) build action is not supported

         A Content item has no meaning for an APK, so drop the content files alongside the desktop
         native assets instead of leaving a warning that fails -warnaserror builds. -->
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" ExcludeAssets="native;contentFiles" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Fody does not handle Android build well, and warns when unchanged.
         Since Realm objects are not declared directly in Android projects, simply disable Fody. -->
    <DisableFody>true</DisableFody>
  </PropertyGroup>
  <!-- osu.Framework.Android depends on https://www.nuget.org/packages/Xamarin.AndroidX.Window,
       which - via a chain of transitive dependencies - also includes https://www.nuget.org/packages/Xamarin.Jetbrains.Annotations,
       which causes compile failures such as:

         The type 'NotNullAttribute' exists in both 'JetBrains.Annotations, Version=4242.42.42.42, Culture=neutral, PublicKeyToken=1010a0d8d6380325'
         and 'Xamarin.Jetbrains.Annotations, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null' [D:\a\osu\osu\osu.Game.Tests.Android\osu.Game.Tests.Android.csproj]

       We cannot easily change the source files, because of how this project works
       (all source files are basically symlinked from the desktop test project,
       so changing anything there just for the sake of mobile would be strange).
       Thus, apply the following "interesting" workaround as borrowed from https://stackoverflow.com/a/65127159 instead. -->
  <Target Name="AddPackageAliases" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="%(Filename) == 'Xamarin.Jetbrains.Annotations'">
        <Aliases>XamarinJetbrainsAnnotations</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>
  <!-- Safety net for the exclusions above: no shared library coming from a desktop RID folder may
       reach the APK, whichever package it originates from. RIDs starting with "linux-bionic" are the
       bionic (Android) flavour of Linux and are therefore kept. -->
  <Target Name="RemoveDesktopNativeLibraries" AfterTargets="_ResolveAssemblies">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.so'
                                        and $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Replace('\', '/').Contains('/runtimes/'))
                                        and !$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Replace('\', '/').Contains('/runtimes/android'))
                                        and !$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Replace('\', '/').Contains('/runtimes/linux-bionic'))" />
    </ItemGroup>
  </Target>
</Project>
