<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offscreen previewer for the ui-design skill. Not part of any solution; build it on its own (see ../../SKILL.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Only this platform's native assets; the iOS ones exceed the Windows path limit this deep in the repository. -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The referenced test projects bring the test platform, whose generated entry point would replace Program.Main. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <G0V0FrameworkVersion Condition="'$(G0V0FrameworkVersion)' == ''">2026.1029.2</G0V0FrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <!-- The visual test scenes that the scene argument runs. -->
    <ProjectReference Include="..\..\..\..\..\osu.Game.Tests\osu.Game.Tests.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Osu.Tests\osu.Game.Rulesets.Osu.Tests.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Taiko.Tests\osu.Game.Rulesets.Taiko.Tests.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Catch.Tests\osu.Game.Rulesets.Catch.Tests.csproj" />
    <ProjectReference Include="..\..\..\..\..\osu.Game.Rulesets.Mania.Tests\osu.Game.Rulesets.Mania.Tests.csproj" />
  </ItemGroup>
  <!-- The framework's source generator only reaches direct references, so reference the framework here as well, following the client's package/source switch. -->
  <ItemGroup Condition="'$(G0V0SourceFramework)' == 'true'">
    <ProjectReference Include="$(_G0V0FrameworkRoot)osu.Framework/osu.Framework.csproj" />
    <PackageReference Include="ppy.osu.Framework.SourceGeneration" Version="2025.1121.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(G0V0SourceFramework)' != 'true'">
    <PackageReference Include="g0v0.Framework" Version="$(G0V0FrameworkVersion)" />
  </ItemGroup>
  <!-- Apple native frameworks from a source Veldrid build exceed the Windows path limit here and are not needed. -->
  <Target Name="DropAppleNativeContent" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="$([System.String]::Copy('%(TargetPath)').Contains('xcframework'))" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="$([System.String]::Copy('%(TargetPath)').Contains('xcframework'))" />
    </ItemGroup>
  </Target>
</Project>
